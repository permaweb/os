      "priv": {
        "api-key": "****"
      }
    },
    "openai": {
      "base-url": "https://api.openai.com/v1",
      "default-model": "gpt-4.1",
      "priv": {
        "api-key": "****"
      }
    }
  },
  "trusted-devices": {
    "agent@1.0": "bjolkLzCYweY41Bl8La93bAc1EXR3Cz9VgfPnoCJwjg",
    "inference@1.0": "VJySpkQaiGWZpHWGjxxGUvA97xDAJg8Uq8LXAo5JaFI",
    "ouroboros@1.0": "hMr_dRQNaTQFb8dU7KqMywZXHp5x6P3RU8EMRk-2g3E",
