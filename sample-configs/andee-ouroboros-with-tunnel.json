      "base-url": "https://api.openai.com/v1",
      "default-model": "gpt-4.1",
      "priv": {
        "api-key": "****"
      }
    }
  },
  "trusted-devices": {
    "agent@1.0": "c9VNrqBmu3dcM4Xeyz5I_HG8tdFUiC6RWde8jd49CG0",
    "inference@1.0": "8CAlsOd88mfEAmkhBLbskt0zH5nE2WnvOnguweV3BHY",
