%% Runtime packaging compiles Erlang bytecode here and cross-builds every
%% native component explicitly in build-hb-android-runtime.sh. Suppress the
%% dependency projects' host-native hooks so a macOS WAMR, LMDB, secp256k1,
%% and NIF tree is not built only to be discarded.
{erl_opts, [
    debug_info,
    {i, "_build/default/lib/hb/include"},
    {i, "_build/default/lib/hb/src/core"},
    {feature, maybe_expr, enable}
]}.

{src_dirs, [
    "src",
    "src/security",
    "src/sandbox",
    "../common/src/sandbox"
]}.

{deps, [
    {hb,
        {git, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "43d40acd40729f81bb77958c243aa8b0d392183d"}}}
]}.

{overrides, [
    {override, hb, [
        {plugins, []},
        {project_plugins, []},
        {pre_hooks, []},
        {post_hooks, []},
        {provider_hooks, []},
        {port_specs, []}
    ]},
    {override, elmdb, [
        {plugins, []},
        {pre_hooks, []},
        {post_hooks, []},
        {provider_hooks, []}
    ]},
    {override, b64veryfast, [
        {plugins, []},
        {pre_hooks, []},
        {post_hooks, []},
        {provider_hooks, []},
        {port_specs, []}
    ]}
]}.
