{erl_opts, [
    debug_info,
    {feature, maybe_expr, enable}
]}.

{deps, [
    {hb,
        {git, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "312988c2b36ddebc1585ad7fae9a1b63d1152bd3"}}}
]}.

{plugins, [
    {pc, "1.15.0"},
    {rebar3_rustler, "0.1.1"},
    {rebar_edown_plugin, "0.7.0"},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}},
    {plugin,
        {git_subdir, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "312988c2b36ddebc1585ad7fae9a1b63d1152bd3"},
            "src/forge"}}
]}.

{shell, [{apps, [hb]}]}.

{eunit, [{apps, [hb]}]}.

{alias, [
    {'eunit-all', [{device, "test --with-core"}]}
]}.
