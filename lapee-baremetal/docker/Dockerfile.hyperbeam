# HyperBEAM release builder for x86_64 Linux.
#
# Erlang/OTP 27.3.4.10 on Debian bookworm — the upstream Erlang
# Docker image. Pinned by digest so an upstream point-release
# cannot silently change the bundled erts ABI.
#
# We layer libtss2-dev (for the dev_tpm2 NIF) plus the autotools
# the rebar3 NIF chain pulls in. Everything else (compiler, ssl
# headers) ships in the upstream erlang base image.
#
# Dropped versus the v1.2 Dockerfile: tpm2-tools (CLI not used
# in the build path).
#
# Rust stays — the `rebar3_cargo' plugin in HB's rebar.config
# invokes cargo to build several NIFs (hb_keccak, dev_snp_nif).
# Even though the LapEE-enforced config doesn't preload all of
# them, the release build always compiles every listed app, so
# the entire NIF chain has to compile or rebar3 short-circuits.
FROM erlang:27.3.4.10@sha256:e4c06a8660e95c807b8f52768a65781fa8efcb74f5e978a8b596938055d8cf7a

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        autoconf \
        ca-certificates \
        cmake \
        curl \
        git \
        libgmp-dev \
        libssl-dev \
        libtss2-dev \
        m4 \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Rust for the `rebar3_cargo' provider hooks. Pinned to a
# specific toolchain version + a specific rustup-init.sh sha256
# so this layer is reproducible. Bumping = updating both the
# RUST_VERSION ARG and the RUSTUP_SHA256 (regenerated by
# `curl -sSL https://sh.rustup.rs | sha256sum').
ARG RUST_VERSION=1.91.0
RUN curl --proto '=https' --tlsv1.2 -sSf -o /tmp/rustup-init.sh \
        https://sh.rustup.rs && \
    sh /tmp/rustup-init.sh -y \
        --default-toolchain ${RUST_VERSION} \
        --profile minimal && \
    rm /tmp/rustup-init.sh
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src
CMD ["/bin/bash"]
