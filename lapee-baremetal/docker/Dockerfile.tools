# Image-assembly tools for the LapEE USB build.
#
# Used by:
#   - scripts/build-usb-image.sh  ukify + objcopy (UKI assembly),
#                                 parted (GPT), dosfstools + mtools
#                                 (FAT32 ESP populate without
#                                 privileged mount), dd (sector copy).
#   - scripts/boot-usb-image.sh   parted + dd + mtools (writeback
#                                 extract from the QEMU ESP).
#   - scripts/sb-setup.sh         sbsign / sbverify (UKI signing),
#                                 cert-to-efi-sig-list +
#                                 sign-efi-sig-list (UEFI .auth bundles).
#
# FROM is pinned to a specific debian:12-slim digest. Alpine
# doesn't ship sbsigntool; Debian 12 doesn't ship systemd-ukify
# (that's trixie+). build-usb-image.sh has both code paths and
# falls through to objcopy + linuxx64.efi.stub (from
# systemd-boot-efi) when ukify isn't on PATH — the same UKI ends
# up on disk either way.
FROM debian:12-slim@sha256:f9c6a2fd2ddbc23e336b6257a5245e31f996953ef06cd13a59fa0a1df2d5c252

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        binutils \
        ca-certificates \
        dosfstools \
        efitools \
        mtools \
        openssl \
        parted \
        sbsigntool \
        systemd-boot-efi \
        uuid-runtime \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["/bin/bash"]
