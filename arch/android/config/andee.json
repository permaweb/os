{
  "render-index-page": false,
  "initialized": "permanent",
  "measurement-device": "andee@1.0",
  "store": [
    {
      "store-module": "hb_store_lmdb",
      "name": "../node-store",
      "capacity": 8589934592,
      "batch-size": 100,
      "ao-types": "store-module=\"atom\", capacity=\"integer\", batch-size=\"integer\""
    },
    {
      "store-module": "hb_store_gateway",
      "access": ["read"],
      "ao-types": "store-module=\"atom\"",
      "local-store": [
        {
          "store-module": "hb_store_volatile",
          "name": "andee-volatile-gateway-cache",
          "ao-types": "store-module=\"atom\""
        }
      ],
      "preloaded-store": {
        "store-module": "hb_store_lmdb",
        "name": "_build/preloaded-store",
        "capacity": 1073741824,
        "read-only": true,
        "ao-types": "store-module=\"atom\""
      }
    }
  ],
  "match-index": [
    {
      "store-module": "hb_store_volatile",
      "name": "andee-volatile-match-index",
      "ao-types": "store-module=\"atom\""
    }
  ],
  "arweave-index-store": {
    "store-module": "hb_store_arweave",
    "ao-types": "store-module=\"atom\"",
    "index-store": [
      {
        "store-module": "hb_store_volatile",
        "name": "andee-volatile-arweave-index-store",
        "ao-types": "store-module=\"atom\""
      }
    ]
  },
  "priv-store": [
    {
      "store-module": "hb_store_volatile",
      "name": "andee-volatile-priv-store",
      "ao-types": "store-module=\"atom\""
    }
  ],
  "on": {
    "start": [
      {
        "device": "measurement@1.0",
        "path": "boot",
        "method": "POST",
        "target": "body",
        "measurement-body-source": "hook-body",
        "hook": {
          "result": "ignore"
        }
      }
    ]
  }
}
