{
  "render-index-page": false,
  "initialized": "permanent",
  "measurement-device": "andee@1.0",
  "store": [
    {
      "store-module": "hb_store_volatile",
      "name": "andee-volatile-store"
    }
  ],
  "match-index": [
    {
      "store-module": "hb_store_volatile",
      "name": "andee-volatile-match-index"
    }
  ],
  "priv-store": [
    {
      "store-module": "hb_store_volatile",
      "name": "andee-volatile-priv-store"
    }
  ],
  "on": {
    "start": [
      {
        "device": "measurement@1.0",
        "path": "boot",
        "method": "POST",
        "target": "body",
        "measurement-body-source": "hook-body",
        "hook": {
          "result": "ignore"
        }
      }
    ]
  }
}
