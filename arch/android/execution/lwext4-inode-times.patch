+int ext4_inode_times_set(const char *mount_point, uint32_t inode,
+		uint32_t atime, uint32_t mtime, uint32_t ctime)
+{
+	struct ext4_mountpoint *mp = ext4_get_mount(mount_point);
+	struct ext4_inode_ref ref;
+	int r;
+
+	if (!mp)
+		return ENOENT;
+
+	EXT4_MP_LOCK(mp);
+	r = ext4_fs_get_inode_ref(&mp->fs, inode, &ref);
+	if (r != EOK)
+		goto finish;
+	ext4_inode_set_access_time(ref.inode, atime);
+	ext4_inode_set_modif_time(ref.inode, mtime);
+	ext4_inode_set_change_inode_time(ref.inode, ctime);
+	ref.dirty = true;
+	r = ext4_fs_put_inode_ref(&ref);
+
+finish:
+	EXT4_MP_UNLOCK(mp);
+	return r;
+}
+
