+int ext4_fopen_inode(ext4_file *file, const char *mount_point,
+		uint32_t inode, int flags)
+{
+	struct ext4_mountpoint *mp = ext4_get_mount(mount_point);
+	struct ext4_inode_ref ref;
+	int r;
+
+	if (!mp)
+		return ENOENT;
+	if ((flags & O_CREAT) != 0)
+		return EINVAL;
+
+	EXT4_MP_LOCK(mp);
+	r = ext4_fs_get_inode_ref(&mp->fs, inode, &ref);
+	if (r != EOK)
+		goto finish;
+	if (!ext4_inode_is_type(
+			&mp->fs.sb, ref.inode, EXT4_INODE_MODE_FILE)) {
+		r = EINVAL;
+		goto put_ref;
+	}
+
+	file->mp = mp;
+	file->inode = inode;
+	file->flags = flags;
+	file->fsize = ext4_inode_get_size(&mp->fs.sb, ref.inode);
+	file->fpos = (flags & O_APPEND) != 0 ? file->fsize : 0;
+
+put_ref:
+	{
+		int put_result = ext4_fs_put_inode_ref(&ref);
+		if (r == EOK)
+			r = put_result;
+	}
+finish:
+	EXT4_MP_UNLOCK(mp);
+	return r;
+}
