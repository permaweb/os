# Docker Engine supplies the general namespace, cgroup, seccomp, overlayfs,
# bridge, veth, and netfilter fixups through Buildroot. These enforcement
# controls are still missing from the upstream recipe and are required by the
# bounded PermawebOS container policy.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
