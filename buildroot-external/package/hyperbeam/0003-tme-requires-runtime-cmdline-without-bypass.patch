+    PcrDigestOk = maps:get(<<"verifiable">>, QI, false) =:= true
+        andalso maps:get(<<"pcr-digest-match">>, QI, false) =:= true,
+    SignatureOk = verify_quote_signature(E) =:= true,
+    Pcr15 =/= <<"unknown">>
+        andalso Pcr15Quoted
+        andalso PcrDigestOk
+        andalso SignatureOk.
 
