+binary_has_token(Bin, Token) when is_binary(Bin), is_binary(Token) ->
+    Haystack = <<" ", Bin/binary, " ">>,
+    Needle = <<" ", Token/binary, " ">>,
+    binary:match(Haystack, Needle) =/= nomatch;
+binary_has_token(_, _) ->
+    false.
+
+pcr15_quote_ok(E) ->
